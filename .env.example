# Public Google OAuth client ID for Flashcode's Desktop app registration.
# Copy to .env.local for development, or set in the release build environment.
# Never put tokens or client secrets in VITE_* variables.
VITE_GOOGLE_OAUTH_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com

# Google Desktop OAuth client secret (embedded in Rust release builds, not Vite).
# Desktop binaries cannot keep this confidential. Never use a Web application client secret here.
GOOGLE_OAUTH_CLIENT_SECRET=YOUR_CLIENT_SECRET
